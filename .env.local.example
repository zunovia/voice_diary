# ============================================
# Voice Diary Memo - 環境変数設定
# ============================================
# このファイルを .env.local にコピーして値を入力してください
# cp .env.local.example .env.local
# ============================================

# --- Supabase（必須）---
# https://supabase.com でプロジェクト作成後、
# Settings > API から取得
# （anon key はサーバー側で service role key のみ使用するため不要）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- アクセスキー保護（任意・推奨）---
# 設定すると全ページ・全APIがこのキーで保護される（未設定なら誰でもアクセス可能）
# 各端末で初回に1度入力すればCookieで1年間ログイン状態が続く
# 自動化（バックアップ等）は x-api-key ヘッダーで同じキーを送る
APP_ACCESS_KEY=your-random-access-key

# --- Google Gemini（必須）---
# https://aistudio.google.com/apikey から取得
# 無料枠あり。Pay-as-you-go有効化推奨
GEMINI_API_KEY=your-gemini-api-key

# --- Groq（必須: 高精度音声認識）---
# https://console.groq.com/keys から取得
# Whisper Large V3 Turboによる高精度文字起こし
GROQ_API_KEY=your-groq-api-key
